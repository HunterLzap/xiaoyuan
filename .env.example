# Copy to .env. Environment variables override this file.
AI_PROVIDER=tokendance
AI_BASE_URL=https://tokendance.space/gateway/v1
AI_API_KEY=
# Use the exact model ID from your provider console; do not guess.
AI_MODEL=
AI_MODELS_PROTOCOL=auto
AI_TIMEOUT_SECONDS=30
# Omit AI_MAX_TOKENS to use the provider's default output limit.
AI_HISTORY_TURNS=6
AI_MAX_SESSIONS=100
AI_SYSTEM_PROMPT="你是一个简洁、可靠的个人 AI 助理。使用中文回答，除非用户要求其他语言。"
# Optional confirmed prices per million tokens; leave unset if unknown.
# AI_INPUT_PRICE_PER_MILLION=0
# AI_OUTPUT_PRICE_PER_MILLION=0
AI_CURRENCY=CNY
# Official read-only documentation, used only on explicit search.
AI_M5STACK_ENABLED=true
AI_M5STACK_TIMEOUT_SECONDS=40

AI_TTS_BASE_URL=https://tokendance.space/gateway/v1
AI_TTS_API_KEY=
AI_TTS_MODEL=mimo-v2.5-tts
AI_TTS_VOICE=mimo_default
AI_TTS_INSTRUCTION=
AI_TTS_TIMEOUT_SECONDS=60

AI_TTS_USE_TEXT_CONNECTION=true

# Deployment-only settings; keep empty for local development.
AI_PUBLIC_ORIGIN=
AI_ADMIN_PROXY_TOKEN=
# Optional worker override; defaults to .venv-speech/Scripts/python.exe on
# Windows and .venv-speech/bin/python on Linux.
# AI_SPEECH_PYTHON=
AI_SPEECH_THREADS=2
# AI_ASR_MODEL_DIR=models/asr/sensevoice
